<?xml version="1.0" encoding="utf-8"?>
<!--
  The dark palette. Same names as `values/colors.xml`, one for one.

  Not a mechanical inversion: the accent is lightened rather than darkened,
  because an orange dark enough to read on white disappears against a dark
  surface, and the "soft" fills are near-black tints of the accent rather than
  pale washes.
-->
<resources>
    <color name="bg">#FF0D0E11</color>
    <color name="surface">#FF16181D</color>
    <color name="surface_alt">#FF1E2128</color>
    <color name="border">#FF282C34</color>

    <color name="text_primary">#FFECEEF2</color>
    <color name="text_secondary">#FF98A0AC</color>
    <color name="text_faint">#FF6B7280</color>

    <color name="accent">#FFFF9147</color>
    <color name="accent_soft">#FF2C1B0E</color>
    <color name="on_accent">#FF1A0C02</color>

    <color name="good">#FF4ADE80</color>
    <color name="good_soft">#FF102A1A</color>
    <color name="warn">#FFFBBF24</color>
    <color name="bad">#FFF87171</color>
    <color name="bad_soft">#FF2C1416</color>

    <color name="ripple">#26FFFFFF</color>
</resources>
