<?xml version="1.0" encoding="utf-8"?>
<!--
  The light palette. `values-night/colors.xml` redefines every one of these,
  so nothing in code ever branches on the theme: read the colour, get the
  right one. Anything added here must be added there too.

  Orange is the accent because that is what a pending decision looks like on
  the watch, and the two surfaces should agree.
-->
<resources>
    <color name="bg">#FFF5F6F8</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_alt">#FFEFF1F4</color>
    <color name="border">#FFE1E4EA</color>

    <color name="text_primary">#FF14161A</color>
    <color name="text_secondary">#FF6B7280</color>
    <color name="text_faint">#FF9AA1AC</color>

    <color name="accent">#FFE2590B</color>
    <color name="accent_soft">#FFFDEBDD</color>
    <color name="on_accent">#FFFFFFFF</color>

    <color name="good">#FF15803D</color>
    <color name="good_soft">#FFE3F5E9</color>
    <color name="warn">#FFB45309</color>
    <color name="bad">#FFB91C1C</color>
    <color name="bad_soft">#FFFBE9E9</color>

    <color name="ripple">#1F000000</color>
</resources>
